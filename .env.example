# Environment Variables

Copy this file to `.env` and fill in the values.
⚠️  NEVER commit `.env` to version control.

# ──────────────────────────────────────────────
# GROQ API (backend only – NEVER put this in frontend code)
# ──────────────────────────────────────────────

# Your Groq API key – obtain at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Timeout in milliseconds for Groq API requests (default: 30000 = 30 seconds)
GROQ_TIMEOUT_MS=30000

# ──────────────────────────────────────────────
# MONGODB ATLAS
# ──────────────────────────────────────────────

# Full connection string – obtain from Atlas > Connect > Drivers
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/

# Name of the MongoDB database (created automatically if it doesn't exist)
MONGODB_DB_NAME=interlude_ai

# ──────────────────────────────────────────────
# APPWRITE (backend function environment variables)
# ──────────────────────────────────────────────

# Appwrite project endpoint
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite project ID (Settings > General > Project ID)
APPWRITE_PROJECT_ID=your_appwrite_project_id

# Appwrite API key with the required scopes
# (Settings > API Keys) – needed only if the function calls Appwrite APIs itself
APPWRITE_API_KEY=your_appwrite_api_key

# ──────────────────────────────────────────────
# FRONTEND CONFIGURATION
# (These are safe to expose – no secrets)
# ──────────────────────────────────────────────

# The values below are hard-coded in frontend/app.js > CONFIG object.
# Update them there directly; they do NOT need to be secret.

# APPWRITE_ENDPOINT     = https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID   = your_appwrite_project_id
# APPWRITE_DATABASE_ID  = your_database_id
# APPWRITE_CHAT_FN_ID   = your_chat_function_id
